# Backend Gateway Port
PORT=5001

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_db?schema=public"

# Auth Secret signature (CHANGE IN PRODUCTION — min 32 chars)
JWT_SECRET="super-secret-key-signature-token-12345"

# Frontend URL (used for CORS origin whitelist)
FRONTEND_URL="http://localhost:5173"

# Docker Compose Secrets (override defaults for production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscription_db

# Firebase Client Configuration (Optional - Fallback is LocalStorage Simulator)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-auth-domain.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Stripe Configuration (Optional - Fallback is Mock Checkout Simulator)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Razorpay Configuration (Optional - Fallback is Mock Checkout Simulator)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder

