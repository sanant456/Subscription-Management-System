{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-subvault-backend.railway.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://your-subvault-backend.railway.app/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
